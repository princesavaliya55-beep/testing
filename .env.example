# Kior Perfume - Environment Variables
# Copy this file to .env and put your MongoDB connection string

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/kior-perfume

# Or MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourdb.mongodb.net/kior-perfume?retryWrites=true&w=majority

PORT=5000
